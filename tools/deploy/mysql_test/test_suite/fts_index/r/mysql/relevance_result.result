drop database if exists fts;
create database fts;
use fts;
set ob_query_timeout = 10000000000;
create table memo (id BIGINT AUTO_INCREMENT, title VARCHAR(100), body TEXT, FULLTEXT INDEX fti(title, body));
insert into memo (title, body) values ('全文索引', '全文索引的分词器热路径优化包括解析器实例复用等技术');
insert into memo (title, body) values ('分词器', '分词器热路径优化可以显著降低 CPU 开销');
insert into memo (title, body) values ('倒排索引', '倒排索引是全文检索的核心数据结构');
insert into memo (title, body) values ('Security Audit', 'Completed the annual security audit. No major vulnerabilities were found.');
insert into memo (title, body) values ('Full-text search', 'Full-text search indexing requires efficient tokenization on the hot path.');
result_format: 4
select count(*) from memo where match(title, body) against('全文索引');
+----------+
| count(*) |
+----------+
|        1 |
+----------+
select count(*) from memo where match(title, body) against('分词器');
+----------+
| count(*) |
+----------+
|        1 |
+----------+
select count(*) from memo where match(title, body) against('全文索引 分词器');
+----------+
| count(*) |
+----------+
|        2 |
+----------+
select count(*) from memo where match(title, body) against('全文索引 分词器 倒排索引');
+----------+
| count(*) |
+----------+
|        3 |
+----------+

select id, match(title, body) against('全文索引 分词器') as score from memo
where match(title, body) against('全文索引 分词器') order by score desc, id;
+----+--------------------+
| id | score              |
+----+--------------------+
|  1 | 1.6330723209931362 |
|  2 |  1.539456710235568 |
+----+--------------------+

select id from memo where match(title, body) against('全文索引') > 0 order by id;
+----+
| id |
+----+
|  1 |
+----+
select id from memo where match(title, body) against('全文索引') > 0.5 order by id;
+----+
| id |
+----+
|  1 |
+----+
select id from memo where match(title, body) against('全文索引') < 0.5 order by id;
+----+
| id |
+----+
|  2 |
|  3 |
|  4 |
|  5 |
+----+
select id from memo where match(title, body) against('全文索引') = 0 order by id;
+----+
| id |
+----+
|  2 |
|  3 |
|  4 |
|  5 |
+----+

select id from memo where match(title, body) against('全文索引') order by match(title, body) against('全文索引') desc, id;
+----+
| id |
+----+
|  1 |
+----+

select id from memo where not match(title, body) against('全文索引') order by id;
+----+
| id |
+----+
|  2 |
|  3 |
|  4 |
|  5 |
+----+

select tokenize('全文索引的分词器热路径优化', 'ik');
+-----------------------------------------------------------------+
| tokenize('全文索引的分词器热路径优化', 'ik')                    |
+-----------------------------------------------------------------+
| ["分词器", "优化", "路径", "全文索引", "的", "热"]              |
+-----------------------------------------------------------------+
